# HealthSync AI Health Navigator — Environment Configuration Template

# Backend Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/healthsync?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
GEMINI_API_KEY=your_gemini_api_key_here
TOMTOM_API_KEY=your_tomtom_api_key_here
PORT=5001

# Frontend Configuration (Vite)
VITE_API_URL=/api
VITE_TOMTOM_API_KEY=your_tomtom_api_key_here
